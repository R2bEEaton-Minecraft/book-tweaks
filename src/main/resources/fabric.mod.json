{
	"schemaVersion": 1,
	"id": "book-tweaks",
	"version": "${version}",
	"name": "Book Tweaks",
	"description": "A client-side mod that adds utilities for writing books, including jump-to-start/end buttons and page memory.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/book-tweaks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"cc.spea.booktweaks.BookTweaks"
		],
		"client": [
			"cc.spea.booktweaks.BookTweaksClient"
		]
	},
	"mixins": [
		"book-tweaks.mixins.json",
		{
			"config": "book-tweaks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}